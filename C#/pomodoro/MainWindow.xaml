<Window x:Class="Learning.Pomodoro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro Timer" Height="400" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Timer Display -->
        <Viewbox Grid.Row="0" Margin="20">
            <TextBlock x:Name="TimerDisplay" 
                       Text="25:00" 
                       FontSize="120" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Viewbox>

        <!-- Status Label -->
        <TextBlock x:Name="StatusLabel" 
                   Grid.Row="1" 
                   Text="Ready to start"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   Margin="10"/>

        <!-- Control Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="20">
            <Button x:Name="StartButton" 
                    Content="Start Work Cycle" 
                    Width="150" 
                    Height="40"
                    FontSize="16"
                    Margin="5"
                    Click="StartButton_Click"/>
            <Button x:Name="StopButton" 
                    Content="Stop" 
                    Width="100" 
                    Height="40"
                    FontSize="16"
                    Margin="5"
                    IsEnabled="False"
                    Click="StopButton_Click"/>
        </StackPanel>

        <!-- Progress Bar -->
        <ProgressBar x:Name="TimerProgress" 
                     Grid.Row="3" 
                     Height="20" 
                     Margin="20,10,20,20"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>
    </Grid>
</Window>
